{
  "name": "songquiz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A multiplayer song quiz to play with friends, styled like a late-2000s desktop jukebox.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "build:design-system": "vite build --config vite.design-system.config.ts"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@cloudflare/workers-types": "5.20261003.1",
    "@types/node": "22.18.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "wrangler": "4.147.0"
  }
}
