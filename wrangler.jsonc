// Cloudflare deployment: the website's files plus the Worker in worker/ with one Durable Object
// per room. `npm run dev` runs all of it locally; `npm run deploy` publishes it.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Worker's name on Cloudflare (renamed from "songquiz"; its room storage keeps the old name).
  "name": "iquiz",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // Everything except /api/* is a file from the website build.
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomObject" }]
  },
  "migrations": [
    // SQLite-backed Durable Objects are available on the free plan.
    { "tag": "v1", "new_sqlite_classes": ["RoomObject"] }
  ]
}
